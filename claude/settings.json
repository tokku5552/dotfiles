{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1"
  },
  "permissions": {
    "allow": [
      "mcp__ccd_session_mgmt__set_session_title"
    ],
    "deny": [
      "Bash(git config --global *)",
      "Bash(brew install *)",
      "Bash(npm install -g *)",
      "Bash(chmod 777 *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -f /*)",
      "Bash(rm -f ~/*)",
      "Bash(gh repo delete *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(gh pr merge *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/Library/Application Support/**)"
    ],
    "ask": [
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(bash -c *)",
      "Bash(sh -c *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/scripts/deny-check.sh"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/audit-log.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/scripts/session-title-nudge.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "codex@openai-codex": true,
    "linear-kit@my-private-cc-plugins": false,
    "laplace@coding-agent-plugins": true,
    "asdd-kit@coding-agent-plugins": true,
    "article-kit@my-private-cc-plugins": false,
    "security-guidance@claude-plugins-official": true,
    "ads-jira@ads-ai-workspace": true,
    "proto-box@mercari-mvno-scripts": true,
    "ads-ecpm@ads-ai-workspace": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "my-private-cc-plugins": {
      "source": {
        "source": "github",
        "repo": "tokku5552/cc-plugins"
      },
      "autoUpdate": true
    },
    "coding-agent-plugins": {
      "source": {
        "source": "github",
        "repo": "kouzoh/coding-agent-plugins"
      },
      "autoUpdate": true
    },
    "ads-ai-workspace": {
      "source": {
        "source": "github",
        "repo": "kouzoh/ads-ai-workspace"
      }
    },
    "mercari-mvno-scripts": {
      "source": {
        "source": "github",
        "repo": "kouzoh/mercari-mvno-scripts"
      }
    }
  },
  "effortLevel": "high",
  "advisorModel": "fable",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "teammateMode": "tmux",
  "skipAutoPermissionPrompt": true
}
